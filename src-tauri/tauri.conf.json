{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thc-timer",
  "version": "0.1.4",
  "identifier": "com.thc.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "thc·timer",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNUZBNUQ4RUJBRjQ0NUYKUldSZlJLL3IyS1Zmd3JPdlI3eGljbVlaV3EyRXNpbGJJUitxWTNrZlYvcnJPMmY1YllNeFNzWCsK",
      "endpoints": [
        "https://github.com/thcore/thc-timer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
